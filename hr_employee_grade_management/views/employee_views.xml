<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!--
        grade_id and wage are fields on hr.version (not hr.employee), but
        Odoo 19's versioning setup renders the current version's fields
        inline on the employee form (confirmed: contract_date_start shows
        up directly on the employee's Payroll tab). Referencing them here
        by name follows that same pattern.
    -->
    <record id="view_employee_form_inherit_grade" model="ir.ui.view">
        <field name="name">hr.employee.form.grade</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Grade Information">
                    <field name="grade_id"/>
                    <field name="wage" readonly="1"/>
                    <field name="current_grade_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
