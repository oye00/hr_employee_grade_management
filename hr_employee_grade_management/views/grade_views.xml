<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================
        ACTION
    ========================== -->
    <record id="action_grade_level" model="ir.actions.act_window">
        <field name="name">Grade Levels</field>
        <field name="res_model">grade.level</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- =========================
        LIST VIEW
    ========================== -->
    <record id="view_grade_level_list" model="ir.ui.view">
        <field name="name">grade.level.list</field>
        <field name="model">grade.level</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="wage"/>
                <field name="total_allowance"/>
                <field name="total_package"/>
                <field name="employee_count"/>
            </list>
        </field>
    </record>

    <!-- =========================
        FORM VIEW
    ========================== -->
    <record id="view_grade_level_form" model="ir.ui.view">
        <field name="name">grade.level.form</field>
        <field name="model">grade.level</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_employees"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users">
                            <field name="employee_count" widget="statinfo" string="Employees"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Grade 7"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="wage"/>
                            <field name="total_allowance" readonly="1"/>
                            <field name="total_package" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Allowances" name="allowances">
                            <field name="allowance_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="allowance_type_id"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

</odoo>
