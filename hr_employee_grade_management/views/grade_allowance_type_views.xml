<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_grade_allowance_type" model="ir.actions.act_window">
        <field name="name">Allowance Types</field>
        <field name="res_model">grade.allowance.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_grade_allowance_type_list" model="ir.ui.view">
        <field name="name">grade.allowance.type.list</field>
        <field name="model">grade.allowance.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_grade_allowance_type_form" model="ir.ui.view">
        <field name="name">grade.allowance.type.form</field>
        <field name="model">grade.allowance.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
