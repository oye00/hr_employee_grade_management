<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_grade_history" model="ir.actions.act_window">
        <field name="name">Grade History</field>
        <field name="res_model">grade.history</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_grade_history_list" model="ir.ui.view">
        <field name="name">grade.history.list</field>
        <field name="model">grade.history</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="grade_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>

    <record id="view_grade_history_form" model="ir.ui.view">
        <field name="name">grade.history.form</field>
        <field name="model">grade.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="employee_id" readonly="1"/>
                        <field name="grade_id" readonly="1"/>
                    </group>

                    <group>
                        <field name="start_date" readonly="1"/>
                        <field name="end_date"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

</odoo>
